# ─── Core ────────────────────────────────────────────────────────────────────

# Port exposed on the host. 18081 is gecko-notes, 18082 GAM and 18083 GVC, so the suite
# takes 18084.
APP_PORT=18084

# REQUIRED. This MUST be the same value gecko-notes, GAM and GVC use: until identity
# moves here (M6), the suite verifies the tokens Notes signs.
JWT_SECRET_KEY=

# REQUIRED. Comma-separated Fernet keys; the first encrypts, all of them decrypt. These
# encrypt every provider API key in the suite. Independent of JWT_SECRET_KEY on purpose,
# so rotating sessions does not wipe the keys. Back this up apart from data/: a database
# backup without it is a backup of keys nobody can read. Generate one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SUITE_ENCRYPTION_KEYS=

# Exact origins allowed to call the API cross-origin, with the shared session. From M7 the
# apps' pages ask the suite for their theme directly, so list all three (the cookie origin
# check reads this too; leave one out and its theme picker cannot save):
#   CORS_ORIGIN=https://notes.geckopico.com,https://assets.geckopico.com,https://gvc.geckopico.com
# In development, the apps' Vite origins:
#   CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_ORIGIN=

# Where an unauthenticated visitor is sent to sign in, until the suite signs people in
# itself (M6). In development: NOTES_BASE_URL=http://localhost:8000
NOTES_BASE_URL=https://notes.geckopico.com

# ─── Accounts (M6) ───────────────────────────────────────────────────────────
#
# The suite signs people in from M6. Nothing here changes who signs people in until the
# cutover (NOTES_BASE_URL above pointed at the suite, and Notes' IDENTITY_PROVIDER=suite).

# The session cookie's domain. MUST be the value gecko-notes uses (its AUTH_COOKIE_DOMAIN),
# e.g. .geckopico.com, so one sign-in reaches every app. Blank: host-only, for development.
AUTH_COOKIE_DOMAIN=
# Only false for local http development.
AUTH_COOKIE_SECURE=true

# Where the sign-in page may send someone back to after signing in, comma-separated
# origins. The suite's own origin is always allowed. Anything else lands on the suite.
#   LOGIN_REDIRECT_ORIGINS=https://notes.geckopico.com,https://assets.geckopico.com,https://gvc.geckopico.com
LOGIN_REDIRECT_ORIGINS=

# The suite's public address, for the links in account emails.
#   APP_BASE_URL=https://suite.geckopico.com
APP_BASE_URL=

# Email for verification, password reset and emailed sign-in codes. Off until SMTP_HOST
# and SMTP_FROM are set: new accounts then skip verification and links are logged.
# Copy gecko-notes' values to keep sending from the same address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# ─── Administrators ──────────────────────────────────────────────────────────

# Gecko Notes user ids or usernames, comma-separated, matched exactly. Admins register
# the providers and default task routing everyone shares (from M1).
ADMIN_USERS=

# ─── Development only ────────────────────────────────────────────────────────

# "development" enables DEV_AUTH_USER below. Anything else, and it is ignored.
ENVIRONMENT=production

# Accept unauthenticated requests as this user id, for running the suite without Notes.
# Requires ENVIRONMENT=development as well.
DEV_AUTH_USER=

# ─── Reverse proxy ───────────────────────────────────────────────────────────

# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
