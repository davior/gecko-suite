# ─── Core ────────────────────────────────────────────────────────────────────

# Port exposed on the host. 18081 is gecko-notes, 18082 GAM and 18083 GVC, so the suite
# takes 18084.
APP_PORT=18084

# REQUIRED. This MUST be the same value gecko-notes, GAM and GVC use: until identity
# moves here (M6), the suite verifies the tokens Notes signs.
JWT_SECRET_KEY=

# REQUIRED. Comma-separated Fernet keys; the first encrypts, all of them decrypt. These
# encrypt every provider API key in the suite. Independent of JWT_SECRET_KEY on purpose,
# so rotating sessions does not wipe the keys. Back this up apart from data/: a database
# backup without it is a backup of keys nobody can read. Generate one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SUITE_ENCRYPTION_KEYS=

# Exact origins allowed to call the API cross-origin. Development needs the Vite origin
# here once the frontend exists (M1):
#   CORS_ORIGIN=http://localhost:5176
CORS_ORIGIN=

# Where an unauthenticated visitor is sent to sign in, until the suite signs people in
# itself (M6). In development: NOTES_BASE_URL=http://localhost:8000
NOTES_BASE_URL=https://notes.geckopico.com

# ─── Administrators ──────────────────────────────────────────────────────────

# Gecko Notes user ids or usernames, comma-separated, matched exactly. Admins register
# the providers and default task routing everyone shares (from M1).
ADMIN_USERS=

# ─── Development only ────────────────────────────────────────────────────────

# "development" enables DEV_AUTH_USER below. Anything else, and it is ignored.
ENVIRONMENT=production

# Accept unauthenticated requests as this user id, for running the suite without Notes.
# Requires ENVIRONMENT=development as well.
DEV_AUTH_USER=

# ─── Reverse proxy ───────────────────────────────────────────────────────────

# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
